# CONFIG_CC_OPTIMIZE_FOR_SIZE dimatikan 15 September 2026, SETELAH DIUKUR.
#
# Dengan `y` kernel dikompilasi -Os, yang menukar kecepatan demi ukuran: loop
# unrolling dimatikan dan inlining dibatasi.
#
# Ongkosnya: Image 18.742.648 -> 20.540.792 byte, +1,80 MB (+9,6%). Bukan
# halangan -- partisi boot 32 MiB (BoardConfig.mk:305), boot.img 20,5 MB, sisa
# ~11 MB sesudah perubahan ini.
#
# A/B di perangkat, commit sumber yang SAMA (ef880a42db6), frekuensi dikunci
# governor performance:
#
#   ping flood loopback 20.000 paket   -Os: 1395/1397/1397 ms  (n=3)
#                                      -O2: 1321/1317/1311/1306/1321/1307/1313 ms (n=7)
#                                      -> -5,9%, dua sebaran TIDAK BERIRISAN
#
#   laju syscall (dd bs=1 x 1 juta)    -Os: 1,7173 s (n=3)
#                                      -O2: 1,7126 s (n=8)
#                                      -> -0,27%, DI DALAM derau: tidak berubah
#
# Kedua hasil itu konsisten satu sama lain dan itulah yang membuatnya
# dipercaya: -O2 mempercepat kode C kernel (tumpukan jaringan), dan tidak
# menyentuh jalur masuk/keluar syscall yang didominasi assembly.
#
# Suhu saat uji 44 C, jadi bukan efek termal.
#
# JANGAN pakai angka waktu boot untuk membenarkan ini. ro.boottime.init memang
# turun 8,50 -> 6,84 detik, tetapi pembandingnya cacat: yang 8,50 diukur pada
# boot pertama sesudah flash ROM penuh (ada penyiapan f2fs dan dexopt), yang
# 6,84 sesudah flash kernel saja. Bukan perbandingan terkendali.
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_PANIC_TIMEOUT=5
# Deteksi task menggantung — menangkap init (atau proses mana pun) yang terblokir
# di D state, misalnya macet mount atau I/O. Setelah timeout kernel panic, lalu
# CONFIG_PANIC_TIMEOUT=5 di atas mereboot sendiri; jejaknya beserta STACK TRACE
# task yang terblokir masuk kmsg -> tertangkap console-ramoops.
#
# Bergantung pada DEBUG_KERNEL, yang sudah =y di .config hasil build.
#
# BATASNYA: hanya D state (uninterruptible). init yang menunggu properti, socket,
# atau futex ada di S state dan TIDAK tertangkap — untuk itu ada bootwatchdog.sh.
# Dan panic mereboot ke boot NORMAL, bukan recovery.
#
# Timeout 90 detik dipilih agar menyala SEBELUM bootwatchdog (120 detik), supaya
# kalau penyebabnya memang D state kita mendapat stack trace-nya, bukan sekadar
# reboot. Cukup jauh di atas jendela I/O normal boot pertama.
# Bisa diubah runtime: /proc/sys/kernel/hung_task_timeout_secs
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=90
# Ring buffer kernel: 2^19 = 512 KB, dari default 2^17 = 128 KB.
#
# 128 KB terlalu kecil untuk perangkat ini. Terukur: pada 7,5 jam uptime,
# `dmesg` hanya memuat 2 menit terakhir, dan log boot sudah hilang jauh
# sebelum sempat dibaca -- dua kali menggagalkan diagnosis PSI.
#
# Penyebab utamanya sudah ditekan terpisah (dump register syscall tak dikenal
# di arch/arm64/kernel/traps.c), tapi 128 KB tetap sempit untuk kernel yang
# juga menulis audit SELinux permissive terus-menerus.
#
# Ongkosnya 384 KB RAM statis dari 1887 MB -- 0,02%.
CONFIG_LOG_BUF_SHIFT=19
CONFIG_KALLSYMS=y
CONFIG_DEBUG_FS=y
CONFIG_CC_STACKPROTECTOR=y
CONFIG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_EMBEDDED=y
# Spoof versi kernel DIMATIKAN untuk LineageOS 20 (Android 13).
#
# Ia dibuat untuk LOS 22, tempat basis tidak lagi menyediakan fork art/ sehingga
# gerbang memfd_create ART harus dibohongi dari kernel. LOS 20 menyelesaikan
# masalah yang sama dari sisi lain, dan pemeriksaan satu per satu menunjukkan
# spoof ini tidak membeli apa pun di sini:
#
#   ART memfd     patches/official/art/0001 mencabut pemeriksaannya secara
#                 COMPILE-TIME lewat HAS_MEMFD_BACKPORT -- uname() tidak pernah
#                 dipanggil sama sekali. Sama untuk external/perfetto.
#   bpfloader     system/bpf membandingkan dengan 4.14 / 4.19 / 5.4
#                 (libbpf_android/Loader.cpp:650,767,777). 3.10 maupun 3.17
#                 sama-sama di bawahnya; nol perubahan perilaku.
#   init          ro.kernel.version dipakai init.rc:651-657 dengan pencocokan
#                 PERSIS 4.9 / 4.14 / 4.19 / 5.4. Tidak satu pun cocok dengan
#                 3.10 maupun 3.17.
#   init modul    LoadKernelModules memakai versi untuk memilih /lib/modules/<v>,
#                 tetapi kernel ini tanpa CONFIG_MODULES dan ROM tidak mengirim
#                 /lib/modules sama sekali -- init langsung melewatinya.
#
# DAN ia meleset dari sasaran utamanya di build 64-bit: penyaringnya mencocokkan
# current->comm == "zygote", sedangkan app_main.cpp:167 menamai zygote 64-bit
# "zygote64" pada build __LP64__. Jadi zygote utama tidak pernah ikut ter-spoof.
#
# Yang tersisa hanyalah ONGKOSNYA: ro.kernel.version melaporkan 3.17 padahal
# kernelnya 3.10, dan itu menyesatkan diagnosis berikutnya.
#
# NYALAKAN LAGI hanya kalau ada konsumen baru yang terbukti menuntutnya.
# CONFIG_ANDROID_TREBLE_SPOOF_KERNEL_VERSION is not set
# CONFIG_SLUB_DEBUG is not set
# PROFILING dinyalakan 15 September 2026 BUKAN untuk profiling, melainkan karena
# CONFIG_UID_SYS_STATS (baris di bawah) bergantung padanya:
#
#   drivers/misc/Kconfig
#     config UID_SYS_STATS
#         tristate "Per-UID statistics"
#         depends on PROFILING
#
# Tanpa syarat itu terpenuhi, Kconfig membuangnya DIAM-DIAM walau defconfig
# menyetelnya =y: objeknya tidak pernah dibangun dan /proc/uid_cputime tidak
# pernah ada. Terukur di perangkat sebagai 27 galat tiap boot:
#
#   E KernelCpuUidUserSysTimeReader: failed to remove uids 99000 - 99000
#   java.io.FileNotFoundException: /proc/uid_cputime/remove_uid_range: ENOENT
#
# Akibatnya layar penggunaan baterai tidak bisa mengatribusikan waktu CPU ke
# aplikasi. Baterainya tetap terukur; rinciannya per aplikasi yang hilang.
#
# Baris "is not set" sebelumnya adalah bawaan defconfig awal (59585edea76),
# bukan keputusan yang pernah diambil proyek ini -- diperiksa lewat git log -S.
#
# 15 Sep 2026, kemudian: UID_CPUTIME diganti UID_SYS_STATS, penerusnya di AOSP
# common. Syarat PROFILING-nya sama persis, jadi catatan di atas tetap berlaku.
#
# OPROFILE sengaja TIDAK ikut dinyalakan. PROFILING hanya membuatnya bisa
# DIPILIH (arch/Kconfig:7); ia tetap mati.
CONFIG_PROFILING=y

